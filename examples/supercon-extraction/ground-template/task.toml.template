schema_version = "1.1"

[task]
name = "supercon-extraction/{task_name}"
description = "Extract superconductor properties from paper {refno}."
authors = []
keywords = ["pdf", "materials-science", "property-extraction"]

[metadata]
author_name = "sci-llm"
author_email = "n/a"
difficulty = "research"
category = "information_extraction"
tags = ["pdf", "materials-science", "property-extraction", "{task_name}"]

[verifier]
timeout_sec = 1200.0

[agent]
timeout_sec = 1200.0

[environment]
build_timeout_sec = 600.0
cpus = 1
memory_mb = 1024
storage_mb = 1024
gpus = 0
allow_internet = true
mcp_servers = []

# Forward the host's GOOGLE_API_KEY into the verifier's environment so
# check_prediction.py can call the Gemini embedding + judge APIs.
# Uses Harbor's ${VAR} syntax (task schema 1.1+) to pull from the caller's env.
[verifier.env]
GOOGLE_API_KEY = "${GOOGLE_API_KEY}"

[environment.env]

[solution.env]
